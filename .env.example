# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Host ports (dev only): change if 3000/5432 are already taken on your
# Docker host.
API_HOST_PORT=3000
DB_HOST_PORT=5432

# POSTGRES_PASSWORD sets the db container's actual password; the password
# segment of DATABASE_URL must match it exactly, or the api/worker containers
# won't be able to connect. Defaults to cp_dev_password if unset (fine for
# local dev, never use the default outside your own machine).
POSTGRES_PASSWORD=cp_dev_password
DATABASE_URL=postgres://control_plane:cp_dev_password@db:5432/control_plane

# Bearer token required on admin retry/cancel routes. Generate with:
# openssl rand -base64 32
ADMIN_API_TOKEN=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Webhook signing secret for the seeded api-test-gateway project. The seed
# script does not store this value directly; it stores webhookSecretRef as
# an indirection key naming this env var, and resolves the real secret from
# process.env at verification time. Must match the sending side's secret.
CP_WEBHOOK_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Playwright target for generated browser tests. Point at a locally running
# api-test-gateway for local dev, or the staging gateway URL.
PLAYWRIGHT_TARGET_URL=http://127.0.0.1:3001

# Which AI backend generates change analysis, test plans, and Playwright
# specs. "fake" (default) needs no credentials and is fully offline.
# "openai" needs OPENAI_API_KEY. "opencode" needs a mounted opencode OAuth
# credential: see README for setup. "deepseek" needs DEEPSEEK_API_KEY.
AI_PROVIDER=fake
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# AI_MODEL_DEFAULT=deepseek-chat   (or whatever model name the account uses,
# e.g. a "deepseek-v4-pro" style identifier - confirm the exact model string
# against the DeepSeek account/API docs being used, don't assume the name)

# Leave this commented out. The Docker image already has the real commit
# sha baked in (ARG COMMIT_SHA at build time; config.ts defaults to "dev"
# when unset).
# COMMIT_SHA=dev
